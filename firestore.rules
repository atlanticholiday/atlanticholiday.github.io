rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accessPath() {
      return /databases/$(database)/documents/userAccess/$(request.auth.uid);
    }

    function emailAccessPath() {
      return /databases/$(database)/documents/allowedEmails/$(request.auth.token.email);
    }

    function hasMaterializedAccess() {
      return signedIn() && exists(accessPath());
    }

    function hasEmailAllowlistAccess() {
      return signedIn()
        && request.auth.token.email is string
        && !request.auth.token.email.matches('.*@horario\\.test$')
        && exists(emailAccessPath());
    }

    function approved() {
      return signedIn()
        && (
          (hasMaterializedAccess() && get(accessPath()).data.active == true)
          || (!hasMaterializedAccess() && hasEmailAllowlistAccess())
        );
    }

    function accessData() {
      return hasMaterializedAccess()
        ? get(accessPath()).data
        : get(emailAccessPath()).data;
    }

    function hasRole(role) {
      return approved()
        && accessData().roles is list
        && role in accessData().roles;
    }

    function privileged() {
      return hasRole('admin') || hasRole('manager') || hasRole('supervisor');
    }

    function adminOnly() {
      return hasRole('admin');
    }

    function hasApp(appKey) {
      return approved()
        && accessData().allowedApps is list
        && appKey in accessData().allowedApps;
    }

    function isOwnAttendance(data) {
      return approved()
        && accessData().linkedEmployeeId is string
        && data.employeeId == accessData().linkedEmployeeId;
    }

    function isOwnEmployeeDocument(employeeId) {
      return approved()
        && accessData().linkedEmployeeId is string
        && employeeId == accessData().linkedEmployeeId;
    }

    function hasLinkedEmployee() {
      return approved()
        && accessData().linkedEmployeeId is string
        && accessData().linkedEmployeeId.size() > 0;
    }

    function validSelfServiceProfile(employeeId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'employeeId', 'name', 'staffNumber', 'email', 'phone', 'department',
          'position', 'hireDate', 'employmentType', 'workDays', 'shifts',
          'active', 'schemaVersion', 'updatedAtServer'
        ])
        && data.keys().hasOnly([
          'employeeId', 'name', 'staffNumber', 'email', 'phone', 'department',
          'position', 'hireDate', 'employmentType', 'workDays', 'shifts',
          'active', 'schemaVersion', 'updatedAtServer'
        ])
        && data.employeeId == employeeId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && (data.staffNumber == null || data.staffNumber is int)
        && (data.email == null || (data.email is string && data.email.size() <= 254))
        && (data.phone == null || (data.phone is string && data.phone.size() <= 80))
        && (data.department == null || (data.department is string && data.department.size() <= 120))
        && (data.position == null || (data.position is string && data.position.size() <= 120))
        && (data.hireDate == null || (data.hireDate is string && data.hireDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (data.employmentType == null || (data.employmentType is string && data.employmentType.size() <= 120))
        && data.workDays is list
        && data.shifts is map
        && data.active is bool
        && data.schemaVersion == 1
        && data.updatedAtServer == request.time;
    }

    function selfServiceProfilePath(employeeId) {
      return /databases/$(database)/documents/employee_self_service/$(employeeId);
    }

    function validSelfServiceVacation() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'startDate', 'endDate', 'type', 'status',
          'dayCountMode', 'schemaVersion', 'updatedAtServer'
        ])
        && data.keys().hasOnly([
          'startDate', 'endDate', 'type', 'status',
          'dayCountMode', 'schemaVersion', 'updatedAtServer'
        ])
        && data.startDate is string
        && data.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.endDate is string
        && data.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.endDate >= data.startDate
        && data.type in ['vacation', 'sick', 'unpaid', 'parental', 'training', 'compensatory']
        && data.status is string
        && data.status.size() > 0
        && data.status.size() <= 40
        && data.dayCountMode in ['workdays', 'calendar']
        && data.schemaVersion == 1
        && data.updatedAtServer == request.time;
    }

    function attendanceCredentialPath() {
      return /databases/$(database)/documents/attendance_credentials/$(request.auth.token.email);
    }

    function isAttendanceCredential() {
      return signedIn()
        && request.auth.token.email is string
        && exists(attendanceCredentialPath())
        && get(attendanceCredentialPath()).data.active == true;
    }

    function isCredentialOwnAttendance(data) {
      return isAttendanceCredential()
        && data.employeeId == get(attendanceCredentialPath()).data.employeeId;
    }

    function isDirectAttendanceOwner(data) {
      return isCredentialOwnAttendance(data) || isOwnAttendance(data);
    }

    function isOwnAttendanceRecordId(recordId) {
      return approved()
        && accessData().linkedEmployeeId is string
        && recordId.matches(accessData().linkedEmployeeId + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function isCredentialAttendanceRecordId(recordId) {
      return isAttendanceCredential()
        && recordId.matches(get(attendanceCredentialPath()).data.employeeId + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function isOwnAttendanceDirectoryId(employeeId) {
      return approved()
        && accessData().linkedEmployeeId is string
        && employeeId == accessData().linkedEmployeeId;
    }

    function isCredentialAttendanceDirectoryId(employeeId) {
      return isAttendanceCredential()
        && employeeId == get(attendanceCredentialPath()).data.employeeId;
    }

    function validFreshAttendanceEvent(event) {
      let credential = isAttendanceCredential();
      return event is map
        && event.keys().hasAll([
          'id', 'type', 'occurredAt', 'occurredAtUtc', 'occurredAtEpochMs',
          'timeZone', 'capturedAt', 'source', 'actorUid', 'actorEmail',
          'note', 'trustedServerTime', 'canonicalEventId'
        ])
        && event.keys().hasOnly([
          'id', 'type', 'occurredAt', 'occurredAtUtc', 'occurredAtEpochMs',
          'timeZone', 'capturedAt', 'source', 'actorUid', 'actorEmail',
          'note', 'trustedServerTime', 'canonicalEventId'
        ])
        && event.id is string
        && event.id.size() > 8
        && event.id.size() <= 160
        && event.type in ['clockIn', 'clockOut', 'breakStart', 'breakEnd']
        && event.occurredAt is string
        && event.occurredAtUtc is string
        && event.occurredAtEpochMs is int
        && event.occurredAtEpochMs >= request.time.toMillis() - 60000
        && event.occurredAtEpochMs <= request.time.toMillis() + 60000
        && event.timeZone == 'Europe/Lisbon'
        && event.capturedAt is string
        && event.actorUid == request.auth.uid
        && request.auth.token.email is string
        && event.actorEmail == request.auth.token.email
        && event.note == null
        && event.trustedServerTime == true
        && event.canonicalEventId is string
        && (
          (credential && event.source == 'station')
          || (!credential && event.source == 'web')
        );
    }

    function validCredentialCanonicalPunch(eventId) {
      let data = request.resource.data;
      let credential = get(attendanceCredentialPath()).data;
      return signedIn()
        && request.auth.token.email is string
        && exists(attendanceCredentialPath())
        && credential.active == true
        && data.keys().hasAll([
          'id', 'recordId', 'employeeId', 'dateKey', 'category', 'action',
          'eventType', 'targetEventId', 'reason', 'source', 'actorUid',
          'actorEmail', 'occurredAt', 'occurredAtEpochMs', 'serverRecordedAt',
          'schemaVersion'
        ])
        && data.keys().hasOnly([
          'id', 'recordId', 'employeeId', 'dateKey', 'category', 'action',
          'eventType', 'targetEventId', 'reason', 'source', 'actorUid',
          'actorEmail', 'occurredAt', 'occurredAtEpochMs', 'serverRecordedAt',
          'schemaVersion'
        ])
        && data.id == eventId
        && data.recordId is string
        && data.category == 'attendance'
        && data.action == 'punch'
        && data.employeeId == credential.employeeId
        && data.dateKey is string
        && data.targetEventId is string
        && data.reason == null
        && data.source == 'station'
        && data.actorUid == request.auth.uid
        && data.actorEmail == request.auth.token.email
        && data.occurredAt is string
        && data.eventType in ['clockIn', 'clockOut', 'breakStart', 'breakEnd']
        && data.occurredAtEpochMs is int
        && data.occurredAtEpochMs >= request.time.toMillis() - 60000
        && data.occurredAtEpochMs <= request.time.toMillis() + 60000
        && data.serverRecordedAt == request.time
        && data.schemaVersion == 1;
    }

    function canonicalAttendanceEventPath(eventId) {
      return /databases/$(database)/documents/attendance_events/$(eventId);
    }

    function canonicalEventData(eventId) {
      return getAfter(canonicalAttendanceEventPath(eventId)).data;
    }

    function validCanonicalLink(recordId) {
      let eventId = request.resource.data.lastCanonicalEventId;
      let event = canonicalEventData(eventId);
      return eventId is string
        && existsAfter(canonicalAttendanceEventPath(eventId))
        && event.recordId == recordId
        && event.employeeId == request.resource.data.employeeId
        && event.dateKey == request.resource.data.dateKey
        && event.serverRecordedAt == request.time;
    }

    function validDirectAttendanceCreate(recordId) {
      let canonical = canonicalEventData(request.resource.data.lastCanonicalEventId);
      return isDirectAttendanceOwner(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'employeeId', 'employeeName', 'dateKey', 'punches', 'corrections',
          'voidedEventIds', 'workerAttestation', 'attestationHistory', 'review',
          'reviewHistory', 'createdAt', 'updatedAt', 'updatedAtServer', 'retainUntil', 'schemaVersion',
          'lastCanonicalEventId'
        ])
        && request.resource.data.employeeId is string
        && request.resource.data.employeeName is string
        && request.resource.data.dateKey is string
        && request.resource.data.punches is list
        && request.resource.data.punches.size() == 1
        && validFreshAttendanceEvent(request.resource.data.punches[0])
        && request.resource.data.corrections is list
        && request.resource.data.corrections.size() == 0
        && request.resource.data.voidedEventIds is list
        && request.resource.data.voidedEventIds.size() == 0
        && request.resource.data.workerAttestation == null
        && request.resource.data.attestationHistory is list
        && request.resource.data.attestationHistory.size() == 0
        && request.resource.data.reviewHistory is list
        && request.resource.data.reviewHistory.size() == 0
        && request.resource.data.review is map
        && request.resource.data.updatedAtServer == request.time
        && request.resource.data.schemaVersion == 3
        && validCanonicalLink(recordId)
        && canonical.action == 'punch'
        && canonical.eventType == request.resource.data.punches[0].type
        && canonical.targetEventId == request.resource.data.punches[0].id
        && request.resource.data.punches[0].type == 'clockIn';
    }

    function validCredentialAttendanceCreate(recordId) {
      let data = request.resource.data;
      let punch = data.punches[0];
      let credential = get(attendanceCredentialPath()).data;
      let canonical = getAfter(canonicalAttendanceEventPath(data.lastCanonicalEventId)).data;
      return signedIn()
        && request.auth.token.email is string
        && exists(attendanceCredentialPath())
        && credential.active == true
        && data.employeeId == credential.employeeId
        && recordId == data.employeeId + '_' + data.dateKey
        && data.keys().hasOnly([
          'employeeId', 'employeeName', 'dateKey', 'punches', 'corrections',
          'voidedEventIds', 'workerAttestation', 'attestationHistory', 'review',
          'reviewHistory', 'createdAt', 'updatedAt', 'updatedAtServer', 'retainUntil',
          'schemaVersion', 'lastCanonicalEventId'
        ])
        && data.employeeName is string
        && data.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.punches is list
        && data.punches.size() == 1
        && punch.type == 'clockIn'
        && punch.id is string
        && punch.source == 'station'
        && punch.actorUid == request.auth.uid
        && punch.actorEmail == request.auth.token.email
        && punch.timeZone == 'Europe/Lisbon'
        && punch.note == null
        && punch.trustedServerTime == true
        && punch.occurredAtEpochMs is int
        && punch.occurredAtEpochMs >= request.time.toMillis() - 60000
        && punch.occurredAtEpochMs <= request.time.toMillis() + 60000
        && punch.canonicalEventId == data.lastCanonicalEventId
        && data.corrections is list
        && data.corrections.size() == 0
        && data.voidedEventIds is list
        && data.voidedEventIds.size() == 0
        && data.workerAttestation == null
        && data.attestationHistory is list
        && data.attestationHistory.size() == 0
        && data.reviewHistory is list
        && data.reviewHistory.size() == 0
        && data.review is map
        && data.updatedAtServer == request.time
        && data.schemaVersion == 3
        && canonical.id == data.lastCanonicalEventId
        && canonical.recordId == recordId
        && canonical.employeeId == data.employeeId
        && canonical.eventType == punch.type
        && canonical.targetEventId == punch.id
        && canonical.serverRecordedAt == request.time;
    }

    function validDirectAttendanceAppend(recordId) {
      let nextPunch = request.resource.data.punches[request.resource.data.punches.size() - 1];
      let canonical = canonicalEventData(request.resource.data.lastCanonicalEventId);
      return isDirectAttendanceOwner(resource.data)
        && isDirectAttendanceOwner(request.resource.data)
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.employeeName == resource.data.employeeName
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.punches is list
        && resource.data.punches is list
        && request.resource.data.punches.size() == resource.data.punches.size() + 1
        && request.resource.data.punches.hasAll(resource.data.punches)
        && !(nextPunch in resource.data.punches)
        && validFreshAttendanceEvent(nextPunch)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'punches', 'updatedAt', 'updatedAtServer', 'schemaVersion', 'lastCanonicalEventId'
        ])
        && request.resource.data.updatedAtServer == request.time
        && request.resource.data.schemaVersion == 3
        && nextPunch.canonicalEventId == request.resource.data.lastCanonicalEventId
        && validCanonicalLink(recordId)
        && canonical.action == 'punch'
        && canonical.eventType == nextPunch.type
        && canonical.targetEventId == nextPunch.id
        && (
          resource.data.voidedEventIds.size() > 0
          || (resource.data.punches[resource.data.punches.size() - 1].type == 'clockOut' && nextPunch.type == 'clockIn')
          || (resource.data.punches[resource.data.punches.size() - 1].type in ['clockIn', 'breakEnd'] && nextPunch.type in ['clockOut', 'breakStart'])
          || (resource.data.punches[resource.data.punches.size() - 1].type == 'breakStart' && nextPunch.type in ['breakEnd', 'clockOut'])
        );
    }

    function validCredentialAttendanceAppend(recordId) {
      let data = request.resource.data;
      let nextPunch = data.punches[data.punches.size() - 1];
      let credential = get(attendanceCredentialPath()).data;
      let canonical = getAfter(canonicalAttendanceEventPath(data.lastCanonicalEventId)).data;
      return signedIn()
        && request.auth.token.email is string
        && exists(attendanceCredentialPath())
        && credential.active == true
        && resource.data.employeeId == credential.employeeId
        && data.employeeId == credential.employeeId
        && recordId == data.employeeId + '_' + data.dateKey
        && data.employeeName == resource.data.employeeName
        && data.dateKey == resource.data.dateKey
        && data.punches is list
        && data.punches.size() == resource.data.punches.size() + 1
        && data.punches.hasAll(resource.data.punches)
        && nextPunch.id is string
        && nextPunch.type in ['clockIn', 'clockOut', 'breakStart', 'breakEnd']
        && nextPunch.source == 'station'
        && nextPunch.actorUid == request.auth.uid
        && nextPunch.actorEmail == request.auth.token.email
        && nextPunch.timeZone == 'Europe/Lisbon'
        && nextPunch.note == null
        && nextPunch.trustedServerTime == true
        && nextPunch.occurredAtEpochMs is int
        && nextPunch.occurredAtEpochMs >= request.time.toMillis() - 60000
        && nextPunch.occurredAtEpochMs <= request.time.toMillis() + 60000
        && nextPunch.canonicalEventId == data.lastCanonicalEventId
        && data.diff(resource.data).affectedKeys().hasOnly([
          'punches', 'updatedAt', 'updatedAtServer', 'schemaVersion', 'lastCanonicalEventId'
        ])
        && data.updatedAtServer == request.time
        && canonical.id == data.lastCanonicalEventId
        && canonical.recordId == recordId
        && canonical.employeeId == data.employeeId
        && canonical.eventType == nextPunch.type
        && canonical.targetEventId == nextPunch.id
        && canonical.serverRecordedAt == request.time
        && (
          resource.data.voidedEventIds.size() > 0
          || (resource.data.punches[resource.data.punches.size() - 1].type == 'clockOut' && nextPunch.type == 'clockIn')
          || (resource.data.punches[resource.data.punches.size() - 1].type in ['clockIn', 'breakEnd'] && nextPunch.type in ['clockOut', 'breakStart'])
          || (resource.data.punches[resource.data.punches.size() - 1].type == 'breakStart' && nextPunch.type in ['breakEnd', 'clockOut'])
        );
    }

    function attendanceHistoryPreserved() {
      return request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.employeeName == resource.data.employeeName
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.retainUntil == resource.data.retainUntil
        && request.resource.data.punches is list
        && resource.data.punches is list
        && request.resource.data.punches.hasAll(resource.data.punches)
        && request.resource.data.corrections is list
        && resource.data.corrections is list
        && request.resource.data.corrections.hasAll(resource.data.corrections)
        && request.resource.data.voidedEventIds is list
        && resource.data.voidedEventIds is list
        && request.resource.data.voidedEventIds.hasAll(resource.data.voidedEventIds)
        && request.resource.data.attestationHistory is list
        && resource.data.attestationHistory is list
        && request.resource.data.attestationHistory.hasAll(resource.data.attestationHistory)
        && (!(resource.data.reviewHistory is list)
          || (request.resource.data.reviewHistory is list
            && request.resource.data.reviewHistory.hasAll(resource.data.reviewHistory)))
        && request.resource.data.updatedAtServer == request.time;
    }

    function validPrivilegedAttendanceCreate(recordId) {
      return privileged()
        && request.resource.data.punches is list
        && request.resource.data.punches.size() == 1
        && request.resource.data.corrections is list
        && request.resource.data.corrections.size() == 1
        && request.resource.data.voidedEventIds is list
        && request.resource.data.voidedEventIds.size() == 0
        && request.resource.data.updatedAtServer == request.time
        && validCanonicalLink(recordId)
        && canonicalEventData(request.resource.data.lastCanonicalEventId).action == 'manual-punch'
        && request.resource.data.punches[0].canonicalEventId == request.resource.data.lastCanonicalEventId
        && request.resource.data.corrections[0].canonicalEventId == request.resource.data.lastCanonicalEventId
        && request.resource.data.corrections[0].eventId == canonicalEventData(request.resource.data.lastCanonicalEventId).targetEventId;
    }

    function validPrivilegedAttendanceUpdate(recordId) {
      let action = canonicalEventData(request.resource.data.lastCanonicalEventId).action;
      return privileged()
        && validCanonicalLink(recordId)
        && action in ['manual-punch', 'event-voided', 'manager-reviewed']
        && attendanceHistoryPreserved()
        && (
          (action == 'manual-punch'
            && request.resource.data.punches.size() == resource.data.punches.size() + 1
            && request.resource.data.corrections.size() == resource.data.corrections.size() + 1
            && request.resource.data.corrections[request.resource.data.corrections.size() - 1].canonicalEventId == request.resource.data.lastCanonicalEventId
            && request.resource.data.corrections[request.resource.data.corrections.size() - 1].eventId == canonicalEventData(request.resource.data.lastCanonicalEventId).targetEventId)
          || (action == 'event-voided'
            && request.resource.data.punches.size() == resource.data.punches.size()
            && request.resource.data.corrections.size() == resource.data.corrections.size() + 1
            && request.resource.data.voidedEventIds.size() == resource.data.voidedEventIds.size() + 1
            && request.resource.data.corrections[request.resource.data.corrections.size() - 1].canonicalEventId == request.resource.data.lastCanonicalEventId
            && request.resource.data.voidedEventIds[request.resource.data.voidedEventIds.size() - 1] == canonicalEventData(request.resource.data.lastCanonicalEventId).targetEventId)
          || (action == 'manager-reviewed'
            && request.resource.data.punches.size() == resource.data.punches.size()
            && request.resource.data.corrections.size() == resource.data.corrections.size()
            && request.resource.data.voidedEventIds.size() == resource.data.voidedEventIds.size()
            && request.resource.data.reviewHistory is list
            && request.resource.data.reviewHistory.size() == (!(resource.data.reviewHistory is list) ? 1 : resource.data.reviewHistory.size() + 1)
            && request.resource.data.reviewHistory[request.resource.data.reviewHistory.size() - 1].canonicalEventId == request.resource.data.lastCanonicalEventId)
        );
    }

    function validOwnAttendanceAttestation(recordId) {
      return isOwnAttendance(resource.data)
        && isOwnAttendance(request.resource.data)
        && attendanceHistoryPreserved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'workerAttestation', 'attestationHistory', 'updatedAt', 'updatedAtServer', 'lastCanonicalEventId'
        ])
        && request.resource.data.attestationHistory.size() == resource.data.attestationHistory.size() + 1
        && request.resource.data.workerAttestation.workerUid == request.auth.uid
        && request.resource.data.workerAttestation.workerEmail == request.auth.token.email
        && request.resource.data.workerAttestation.canonicalEventId == request.resource.data.lastCanonicalEventId
        && request.resource.data.attestationHistory[request.resource.data.attestationHistory.size() - 1].canonicalEventId == request.resource.data.lastCanonicalEventId
        && validCanonicalLink(recordId)
        && canonicalEventData(request.resource.data.lastCanonicalEventId).action == 'worker-attested';
    }

    function overtimeHistoryPreserved() {
      return request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.employeeName == resource.data.employeeName
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.legalBasis == resource.data.legalBasis
        && request.resource.data.workplace == resource.data.workplace
        && request.resource.data.compensationChoice == resource.data.compensationChoice
        && request.resource.data.authorizedAt == resource.data.authorizedAt
        && request.resource.data.authorizedByUid == resource.data.authorizedByUid
        && request.resource.data.authorizedBy == resource.data.authorizedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.retainUntil == resource.data.retainUntil
        && request.resource.data.auditTrail is list
        && resource.data.auditTrail is list
        && request.resource.data.auditTrail.hasAll(resource.data.auditTrail)
        && request.resource.data.auditTrail.size() == resource.data.auditTrail.size() + 1
        && request.resource.data.updatedAtServer == request.time;
    }

    function validOvertimeCreate(recordId) {
      return privileged()
        && request.resource.data.status == 'authorized'
        && request.resource.data.startEvent == null
        && request.resource.data.endEvent == null
        && request.resource.data.workerValidation == null
        && request.resource.data.auditTrail is list
        && request.resource.data.auditTrail.size() == 1
        && request.resource.data.updatedAtServer == request.time
        && request.resource.data.schemaVersion == 2
        && validCanonicalLink(recordId)
        && canonicalEventData(request.resource.data.lastCanonicalEventId).action == 'authorized';
    }

    function validOvertimeUpdate(recordId) {
      let action = canonicalEventData(request.resource.data.lastCanonicalEventId).action;
      return overtimeHistoryPreserved()
        && validCanonicalLink(recordId)
        && (
          (action in ['started', 'ended']
            && (privileged() || isOwnAttendance(resource.data))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'startEvent', 'endEvent', 'status', 'workerValidation', 'auditTrail',
              'updatedAt', 'updatedAtServer', 'lastCanonicalEventId'
            ])
            && (action == 'started'
              ? (request.resource.data.startEvent.canonicalEventId == request.resource.data.lastCanonicalEventId
                && request.resource.data.startEvent.type == 'overtimeStart')
              : (request.resource.data.endEvent.canonicalEventId == request.resource.data.lastCanonicalEventId
                && request.resource.data.endEvent.type == 'overtimeEnd')))
          || (action == 'worker-validated'
            && isOwnAttendance(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'workerValidation', 'auditTrail', 'updatedAt', 'updatedAtServer', 'lastCanonicalEventId'
            ])
            && request.resource.data.workerValidation.workerUid == request.auth.uid
            && request.resource.data.workerValidation.workerEmail == request.auth.token.email
            && request.resource.data.workerValidation.canonicalEventId == request.resource.data.lastCanonicalEventId)
          || (action == 'manager-reviewed'
            && privileged()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'managerReview', 'compensatoryRest', 'auditTrail',
              'updatedAt', 'updatedAtServer', 'lastCanonicalEventId'
            ])
            && request.resource.data.managerReview.reviewedByUid == request.auth.uid
            && request.resource.data.managerReview.reviewedBy == request.auth.token.email
            && request.resource.data.managerReview.canonicalEventId == request.resource.data.lastCanonicalEventId)
        );
    }

    function canonicalActorMatchesRequester(data) {
      return data.actorUid == request.auth.uid
        && request.auth.token.email is string
        && data.actorEmail == request.auth.token.email;
    }

    function validCanonicalAttendancePunch(data) {
      return data.action == 'punch'
        && data.eventType in ['clockIn', 'clockOut', 'breakStart', 'breakEnd']
        && data.occurredAtEpochMs is int
        && data.occurredAtEpochMs >= request.time.toMillis() - 60000
        && data.occurredAtEpochMs <= request.time.toMillis() + 60000
        && ((data.source == 'station' && isCredentialOwnAttendance(data))
          || (data.source == 'web' && isOwnAttendance(data)));
    }

    function validCanonicalEventCreate(eventId) {
      let data = request.resource.data;
      return signedIn()
        && data.keys().hasAll([
          'id', 'recordId', 'employeeId', 'dateKey', 'category', 'action',
          'eventType', 'targetEventId', 'reason', 'source', 'actorUid',
          'actorEmail', 'occurredAt', 'occurredAtEpochMs', 'serverRecordedAt',
          'schemaVersion'
        ])
        && data.keys().hasOnly([
          'id', 'recordId', 'employeeId', 'dateKey', 'category', 'action',
          'eventType', 'targetEventId', 'reason', 'source', 'actorUid',
          'actorEmail', 'occurredAt', 'occurredAtEpochMs', 'serverRecordedAt',
          'schemaVersion'
        ])
        && data.id == eventId
        && data.recordId is string
        && data.employeeId is string
        && data.dateKey is string
        && data.serverRecordedAt == request.time
        && data.schemaVersion == 1
        && canonicalActorMatchesRequester(data)
        && (
          (data.category == 'attendance' && (
            validCanonicalAttendancePunch(data)
            || (data.action in ['manual-punch', 'event-voided', 'manager-reviewed']
              && privileged() && data.source == 'manual')
            || (data.action == 'worker-attested'
              && isOwnAttendance(data) && data.source == 'web')
          ))
          || (data.category == 'overtime' && (
            (data.action in ['authorized', 'manager-reviewed']
              && privileged() && data.source == 'manual')
            || (data.action in ['started', 'ended']
              && (privileged() || isOwnAttendance(data))
              && data.source == 'web'
              && data.occurredAtEpochMs is int
              && data.occurredAtEpochMs >= request.time.toMillis() - 60000
              && data.occurredAtEpochMs <= request.time.toMillis() + 60000)
            || (data.action == 'worker-validated'
              && isOwnAttendance(data) && data.source == 'web')
          ))
        );
    }

    function validStationStatusUpdate() {
      return isDirectAttendanceOwner(resource.data)
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.name == resource.data.name
        && request.resource.data.attendancePinConfigured == resource.data.attendancePinConfigured
        && request.resource.data.attendancePinLoginEmail == resource.data.attendancePinLoginEmail
        && request.resource.data.isArchived == resource.data.isArchived
        && request.resource.data.status in ['clocked-out', 'working', 'on-break']
        && request.resource.data.lastEventType in ['clockIn', 'clockOut', 'breakStart', 'breakEnd']
        && request.resource.data.lastOccurredAtEpochMs is int
        && request.resource.data.lastOccurredAtEpochMs >= request.time.toMillis() - 60000
        && request.resource.data.lastOccurredAtEpochMs <= request.time.toMillis() + 60000
        && request.resource.data.updatedAtServer == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'lastEventType', 'lastOccurredAtEpochMs', 'updatedAtServer'
        ]);
    }

    function taskAssignedToCurrentUser(data) {
      return approved()
        && accessData().linkedEmployeeId is string
        && data.assigneeIds is list
        && accessData().linkedEmployeeId in data.assigneeIds;
    }

    function canReadTaskData(data) {
      return privileged() || taskAssignedToCurrentUser(data);
    }

    function colleagueTaskCreateAllowed() {
      return taskAssignedToCurrentUser(request.resource.data)
        && request.resource.data.createdBy is map
        && request.resource.data.createdBy.uid == request.auth.uid;
    }

    function colleagueTaskUpdateAllowed() {
      return taskAssignedToCurrentUser(resource.data)
        && taskAssignedToCurrentUser(request.resource.data)
        && request.resource.data.assigneeIds == resource.data.assigneeIds
        && request.resource.data.assignees == resource.data.assignees
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.departmentName == resource.data.departmentName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy is map
        && request.resource.data.updatedBy.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'section',
          'priority',
          'dueDate',
          'status',
          'completedAt',
          'attachments',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function ownsNewRecord() {
      return request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingRecord() {
      return resource.data.userId == request.auth.uid;
    }

    function ownsNewLinenInventoryRecord() {
      return request.resource.data.createdBy is map
        && request.resource.data.createdBy.uid == request.auth.uid;
    }

    function ownsExistingLinenInventoryRecord() {
      return resource.data.createdBy is map
        && resource.data.createdBy.uid == request.auth.uid;
    }

    function linenActorMatchesRequester(actor) {
      return actor is map
        && actor.uid == request.auth.uid
        && request.auth.token.email is string
        && actor.email == request.auth.token.email;
    }

    function linenCreateSubmissionAuditValid() {
      return (
          request.resource.data.workflowStatus == 'draft'
          && request.resource.data.submittedBy is map
          && request.resource.data.submittedBy.uid == ''
          && request.resource.data.submittedAt == ''
        ) || (
          request.resource.data.workflowStatus == 'submitted'
          && linenActorMatchesRequester(request.resource.data.submittedBy)
          && request.resource.data.submittedAt is string
          && request.resource.data.submittedAt.size() > 0
        );
    }

    function linenUpdateSubmissionAuditValid() {
      return (
          request.resource.data.workflowStatus == 'submitted'
          && linenActorMatchesRequester(request.resource.data.submittedBy)
          && request.resource.data.submittedAt is string
          && request.resource.data.submittedAt.size() > 0
        ) || (
          request.resource.data.workflowStatus == resource.data.workflowStatus
          && request.resource.data.submittedBy == resource.data.submittedBy
          && request.resource.data.submittedAt == resource.data.submittedAt
        );
    }

    function linenTargetsAreEmpty() {
      return request.resource.data.targets is map
        && request.resource.data.targets.keys().size() == 0;
    }

    function linenTargetsUnchanged() {
      return request.resource.data.targets == resource.data.targets;
    }

    function linenColleagueCreateAllowed() {
      return hasApp('linenInventory')
        && ownsNewLinenInventoryRecord()
        && linenActorMatchesRequester(request.resource.data.createdBy)
        && linenActorMatchesRequester(request.resource.data.updatedBy)
        && request.resource.data.propertyId is string
        && request.resource.data.propertyId.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() > 0
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() > 0
        && request.resource.data.workflowStatus in ['draft', 'submitted']
        && request.resource.data.reviewedBy is map
        && request.resource.data.reviewedBy.uid == ''
        && request.resource.data.reviewedAt == ''
        && request.resource.data.reviewNote == ''
        && request.resource.data.archivedAt == ''
        && linenCreateSubmissionAuditValid()
        && linenTargetsAreEmpty();
    }

    function linenColleagueUpdateAllowed() {
      return hasApp('linenInventory')
        && ownsExistingLinenInventoryRecord()
        && ownsNewLinenInventoryRecord()
        && resource.data.workflowStatus in ['draft', 'needsCorrection']
        && (
          request.resource.data.workflowStatus == resource.data.workflowStatus
          || request.resource.data.workflowStatus == 'submitted'
        )
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.propertyName == resource.data.propertyName
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reviewedBy == resource.data.reviewedBy
        && request.resource.data.reviewedAt == resource.data.reviewedAt
        && request.resource.data.reviewNote == resource.data.reviewNote
        && request.resource.data.archivedAt == resource.data.archivedAt
        && linenActorMatchesRequester(request.resource.data.updatedBy)
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() > 0
        && linenUpdateSubmissionAuditValid()
        && linenTargetsUnchanged();
    }

    function canReadPropertyDirectory() {
      return privileged()
        || hasApp('properties')
        || hasApp('allinfo')
        || hasApp('welcomePacks')
        || hasApp('owners')
        || hasApp('safety')
        || hasApp('reservations')
        || hasApp('heatedPools')
        || hasApp('inventory');
    }

    function propertySecretsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'icalUrl',
        'airbnbApiToken',
        'avantioApiToken',
        'bookingApiToken',
        'apiKey',
        'apiSecret'
      ]);
    }

    match /userAccess/{uid} {
      allow read: if approved() && (request.auth.uid == uid || adminOnly());
      allow create, update, delete: if adminOnly();
    }

    match /allowedEmails/{emailKey} {
      allow read: if adminOnly()
        || (signedIn()
          && request.auth.token.email is string
          && request.auth.token.email == emailKey
          && !request.auth.token.email.matches('.*@horario\\.test$'));
      allow create, update, delete: if adminOnly();
    }

    match /roles/{roleKey} {
      allow read: if adminOnly();
      allow create, update, delete: if adminOnly();
    }

    match /securityAudit/{entryId} {
      allow read: if adminOnly();
      allow write: if false;
    }

    match /guestDataAccessAudit/{entryId} {
      allow read: if adminOnly();
      allow write: if false;
    }

    match /reservations/{reservationId} {
      allow read: if privileged()
        || (hasApp('reservations') && ownsExistingRecord());
      allow create: if (privileged() || hasApp('reservations')) && ownsNewRecord();
      allow update: if privileged()
        || (hasApp('reservations') && ownsExistingRecord() && ownsNewRecord());
      allow delete: if privileged()
        || (hasApp('reservations') && ownsExistingRecord());
    }

    match /properties/{propertyId} {
      allow read: if canReadPropertyDirectory();
      allow create: if (privileged() || hasApp('properties'))
        && !request.resource.data.keys().hasAny([
          'icalUrl',
          'airbnbApiToken',
          'avantioApiToken',
          'bookingApiToken',
          'apiKey',
          'apiSecret'
        ]);
      allow update: if (
          (privileged() || hasApp('properties') || hasApp('allinfo'))
          && propertySecretsUnchanged()
        ) || (
          hasApp('welcomePacks')
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['welcomePackEnabled', 'updatedAt'])
        ) || (
          hasApp('owners')
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerId', 'updatedAt'])
        );
      allow delete: if privileged() || hasApp('properties');
    }

    match /propertyDirectory/{propertyId} {
      allow read: if canReadPropertyDirectory() || hasApp('linenInventory');
      allow create, update: if (
          privileged() || hasApp('properties') || hasApp('allinfo')
        )
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;
      allow delete: if privileged() || hasApp('properties') || hasApp('allinfo');
    }

    match /propertyImportReports/{reportId} {
      allow read, write: if privileged() || hasApp('properties');
    }

    match /owners/{ownerId} {
      allow read, write: if privileged() || hasApp('owners');

      match /secure/{secureDocument} {
        allow read, write: if privileged() || hasApp('owners');
      }
    }

    match /welcome_pack_items/{itemId} {
      allow read, write: if privileged() || hasApp('welcomePacks');
    }

    match /welcome_pack_logs/{logId} {
      allow read, write: if privileged() || hasApp('welcomePacks');
    }

    match /welcome_pack_presets/{presetId} {
      allow read, write: if privileged() || hasApp('welcomePacks');
    }

    match /welcome_pack_purchases/{purchaseId} {
      allow read, write: if privileged() || hasApp('welcomePacks');
    }

    match /heatedPools/{recordId} {
      allow read, write: if privileged() || hasApp('heatedPools') || hasApp('reservations');
    }

    match /taskDepartments/{departmentId} {
      allow read: if approved();
      allow create, update, delete: if privileged();
    }

    match /tasks/{taskId} {
      allow read: if canReadTaskData(resource.data);
      allow create: if privileged() || colleagueTaskCreateAllowed();
      allow update: if privileged() || colleagueTaskUpdateAllowed();
      allow delete: if privileged();

      match /comments/{commentId} {
        allow read: if canReadTaskData(
          get(/databases/$(database)/documents/tasks/$(taskId)).data
        );
        allow create: if canReadTaskData(
            get(/databases/$(database)/documents/tasks/$(taskId)).data
          )
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if privileged()
          || (
            canReadTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == request.auth.uid
          );
      }
    }

    match /laundryHandoffRecords/{recordId} {
      allow read, create, update: if privileged() || hasApp('laundryLog');
      allow delete: if privileged();
    }

    match /linenInventoryRecords/{recordId} {
      allow read: if privileged()
        || (hasApp('linenInventory') && ownsExistingLinenInventoryRecord());
      allow create: if privileged() || linenColleagueCreateAllowed();
      allow update: if privileged() || linenColleagueUpdateAllowed();
      allow delete: if privileged();
    }

    match /cleaningAhRecords/{recordId} {
      allow read, write: if privileged() || hasApp('cleaningAh');
    }

    match /cleaningAhLaundryRecords/{recordId} {
      allow read, write: if privileged() || hasApp('cleaningAh');
    }

    match /cleaningAhSpecialCleaningRecords/{recordId} {
      allow read, write: if privileged() || hasApp('cleaningAh');
    }

    match /inventoryEssentials/{documentId} {
      allow read, write: if privileged() || hasApp('inventory');
    }

    match /essentialsLists/{listId} {
      allow read, write: if privileged() || hasApp('inventory');
    }

    match /plenoHotelRecords/{recordId} {
      allow read, write: if privileged() || hasApp('inventory');
    }

    match /operations/{recordId} {
      allow read: if privileged()
        || (approved() && ownsExistingRecord());
      allow create: if privileged() || (approved() && ownsNewRecord());
      allow update: if privileged()
        || (approved() && ownsExistingRecord() && ownsNewRecord());
      allow delete: if privileged()
        || (approved() && ownsExistingRecord());
    }

    match /rnal_data/{recordId} {
      allow read: if privileged()
        || (hasApp('rnal') && ownsExistingRecord());
      allow create: if (privileged() || hasApp('rnal')) && ownsNewRecord();
      allow update: if privileged()
        || (hasApp('rnal') && ownsExistingRecord() && ownsNewRecord());
      allow delete: if privileged()
        || (hasApp('rnal') && ownsExistingRecord());
    }

    match /employees/{employeeId} {
      allow get: if privileged() || hasApp('staff');
      allow list: if privileged() || hasApp('staff');
      allow write: if privileged() || hasApp('staff');
    }

    // Personal self-service projection. It deliberately omits internal notes,
    // PIN data, overtime details and management-only profile fields.
    match /employee_self_service/{employeeId} {
      allow get: if privileged()
        || hasApp('staff')
        || (isOwnEmployeeDocument(employeeId) && resource.data.active == true);
      allow list: if privileged() || hasApp('staff');
      allow create, update: if (privileged() || hasApp('staff'))
        && validSelfServiceProfile(employeeId);
      // Client-side deletion would leave nested vacation records orphaned.
      // Archive by replacing the profile with an inactive, PII-free tombstone.
      allow delete: if false;

      // Detailed leave projection for the record owner, without the source
      // record's free-text note or management metadata.
      match /vacation_records/{recordId} {
        allow read: if privileged()
          || hasApp('staff')
          || (
            isOwnEmployeeDocument(employeeId)
            && exists(selfServiceProfilePath(employeeId))
            && get(selfServiceProfilePath(employeeId)).data.active == true
          );
        allow create, update: if (privileged() || hasApp('staff'))
          && validSelfServiceVacation();
        allow delete: if privileged() || hasApp('staff');
      }
    }

    // Minimum operational projection for the read-only team schedule. Private
    // profile, attendance, overtime and leave-detail fields are not accepted.
    match /schedule_directory/{employeeId} {
      allow read: if privileged()
        || ((hasRole('employee') || hasLinkedEmployee()) && !hasRole('time-clock-station'));
      allow create, update: if (privileged() || hasApp('staff'))
        && request.resource.data.keys().hasAll([
          'name', 'department', 'workDays', 'shifts', 'overrides',
          'availabilityPeriods', 'schemaVersion', 'updatedAtServer'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'department', 'workDays', 'shifts', 'overrides',
          'availabilityPeriods', 'schemaVersion', 'updatedAtServer'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && (request.resource.data.department == null || request.resource.data.department is string)
        && request.resource.data.workDays is list
        && request.resource.data.shifts is map
        && request.resource.data.overrides is map
        && request.resource.data.availabilityPeriods is list
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAtServer == request.time;
      allow delete: if privileged() || hasApp('staff');
    }

    match /attendance_station_directory/{employeeId} {
      allow read: if privileged()
        || isOwnAttendance(resource.data)
        || isCredentialOwnAttendance(resource.data)
        || isOwnAttendanceDirectoryId(employeeId)
        || isCredentialAttendanceDirectoryId(employeeId);
      allow create, delete: if privileged();
      allow update: if validStationStatusUpdate() || privileged();
    }

    match /attendance_records/{recordId} {
      allow get: if privileged()
        || hasApp('staff')
        || isCredentialOwnAttendance(resource.data)
        || isOwnAttendance(resource.data)
        || isCredentialAttendanceRecordId(recordId)
        || isOwnAttendanceRecordId(recordId);
      allow list: if privileged()
        || hasApp('staff')
        || isCredentialOwnAttendance(resource.data)
        || isOwnAttendance(resource.data);

      // Spark-plan writes remain append-only. Firebase Authentication identifies
      // the worker and request.time validates the client timestamp window.
      allow create: if validCredentialAttendanceCreate(recordId)
        || validDirectAttendanceCreate(recordId)
        || validPrivilegedAttendanceCreate(recordId);
      allow update: if validCredentialAttendanceAppend(recordId)
        || validDirectAttendanceAppend(recordId)
        || validPrivilegedAttendanceUpdate(recordId)
        || validOwnAttendanceAttestation(recordId);
      allow delete: if false;
    }

    match /attendance_events/{eventId} {
      allow read: if privileged()
        || hasApp('staff')
        || isOwnAttendance(resource.data)
        || isCredentialOwnAttendance(resource.data);
      allow create: if validCredentialCanonicalPunch(eventId)
        || validCanonicalEventCreate(eventId);
      allow update, delete: if false;
    }

    // PIN salts, hashes and lockout state are server-only credentials. Even
    // administrators manage them through callable functions and never read them.
    match /attendance_pin_credentials/{employeeId} {
      allow read, write: if false;
    }

    // Isolated Firebase Auth identities used only to validate a colleague's PIN.
    // A credential can read only its own mapping; listing is always forbidden.
    match /attendance_credentials/{credentialEmail} {
      allow get: if signedIn()
        && request.auth.token.email == credentialEmail
        && resource.data.email == credentialEmail
        && resource.data.active == true;
      allow list: if false;
      allow create, update, delete: if privileged();
    }

    match /overtime_records/{recordId} {
      allow read: if privileged()
        || hasApp('staff')
        || isOwnAttendance(resource.data);
      allow create: if validOvertimeCreate(recordId);
      allow update: if validOvertimeUpdate(recordId);
      allow delete: if false;
    }

    match /daily_notes/{recordId} {
      allow read: if privileged() || hasApp('staff');
      allow write: if privileged() || hasApp('staff');
    }

    match /shift_presets/{presetId} {
      allow read: if privileged() || hasApp('staff') || hasRole('employee');
      allow write: if privileged() || hasApp('staff');
    }

    match /vacation_records/{recordId} {
      allow read: if privileged() || hasApp('staff') || hasApp('vacationCenter');
      allow write: if privileged() || hasApp('staff');
    }

    match /settings/{settingId} {
      allow read: if approved();
      allow write: if privileged();
    }

    match /users/{uid} {
      allow read, write: if approved() && (request.auth.uid == uid || privileged());

      match /{nestedDocument=**} {
        allow read, write: if approved() && (request.auth.uid == uid || privileged());
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
