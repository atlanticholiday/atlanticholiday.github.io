{
  "name": "horario",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node --disable-warning=ExperimentalWarning server/horario-server.mjs",
    "serve:static": "node scripts/serve-static.mjs",
    "backup": "node server/backup.mjs",
    "attendance:verify-archive": "node scripts/attendance/verify-archive.mjs",
    "test:browser": "node tests/run-headless.mjs",
    "test:firestore-rules": "npx --yes firebase-tools@13.35.1 emulators:exec --only firestore --project demo-horario \"node tests/run-firestore-rules.mjs\"",
    "airbnb:download-invoices": "node scripts/airbnb/invoice-downloader.mjs",
    "airbnb:download-reservation-invoices": "node scripts/airbnb/reservation-invoice-downloader.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.58.2"
  }
}
